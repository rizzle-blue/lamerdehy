{
  "name": "@deepseek-ai/dsh-client-ui-settings-sign-in",
  "description": "Subscription-account sign-in section on the Models page: sign in to ChatGPT, Kiro, and other offered accounts and sign out",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizzle-blue/lamhy.git",
    "directory": "packages/client/ui-settings-sign-in"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-api-authorization-controller": "workspace:*",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-models": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "react": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
